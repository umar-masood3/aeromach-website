# Aeromach Storefront & Fulfillment Environment Variables
# Copy to .env and replace placeholder values with your real credentials.

# Database
DATABASE_URL="file:./aeromach.db"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Aeromach"

# Administrative Access Key
ADMIN_SECRET_KEY="aeromach_admin_change_this_secret_in_prod"

# Razorpay Integration (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Printify Integration (https://printify.com/app/account/api)
PRINTIFY_API_TOKEN="your_printify_personal_access_token"
PRINTIFY_SHOP_ID="your_printify_shop_id"
PRINTIFY_API_BASE_URL="https://api.printify.com/v1"
PRINTIFY_WEBHOOK_SECRET="your_printify_webhook_secret"

# Feature Flags & Testing
ENABLE_TEST_PAYMENT_SIMULATOR="true"
