# Aeromach Storefront & Fulfillment Environment Variables
# Copy to .env and replace placeholder values with your real credentials.
# NEVER commit your real .env file to Git.

# ─── DATABASE ────────────────────────────────────────────────────────────────
# For local development with SQLite:
#   DATABASE_URL="file:./aeromach.db"
#   DIRECT_URL="file:./aeromach.db"
#
# For Neon PostgreSQL (production / Render deployment):
#   1. Go to https://neon.tech and create a free project.
#   2. In the Neon dashboard, copy the "Connection string" (pooled) → DATABASE_URL
#   3. In the Neon dashboard, copy the "Direct connection" string → DIRECT_URL
DATABASE_URL="postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── PUBLIC APP URL ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Aeromach"

# ─── ADMIN ACCESS ────────────────────────────────────────────────────────────
# REQUIRED. Must be set in production or ALL admin routes will be blocked.
# Generate with: openssl rand -hex 32
ADMIN_SECRET_KEY="generate-a-strong-random-secret-here"

# ─── RAZORPAY ────────────────────────────────────────────────────────────────
# https://dashboard.razorpay.com/
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ─── PRINTIFY ────────────────────────────────────────────────────────────────
# https://printify.com/app/account/api
PRINTIFY_API_TOKEN="your_printify_personal_access_token"
PRINTIFY_SHOP_ID="your_printify_shop_id"
PRINTIFY_API_BASE_URL="https://api.printify.com/v1"
PRINTIFY_WEBHOOK_SECRET="your_printify_webhook_secret"

# ─── DEMO / FEATURE FLAGS ────────────────────────────────────────────────────
# Set DEMO_MODE=true  → disables checkout, payments, Printify fulfillment.
# Set DEMO_MODE=false → enables full functionality (requires real credentials above).
# In production, defaults to true unless explicitly set to false.
DEMO_MODE="true"

# Test payment simulator: ONLY for local development.
# NEVER set to true in production — it is unconditionally blocked.
# Feature Flags & Testing
#
# TEST-ONLY PAYMENT SIMULATOR
# ---------------------------
# Defaults to "false" on purpose. Leave it false unless you are actively
# testing the checkout flow on your own machine.
#
# It is honoured ONLY when NODE_ENV is exactly "development" or "test". In
# production, staging, preview, or any unrecognised runtime it is ignored and
# the simulator endpoint returns 404, whatever this value says.
#
# Never set this to "true" on a deployed site: it exists purely so local
# development does not need live gateway credentials.
ENABLE_TEST_PAYMENT_SIMULATOR="false"

