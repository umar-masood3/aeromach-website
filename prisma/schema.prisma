datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id                  String           @id @default(cuid())
  slug                String           @unique
  title               String
  subtitle            String?
  description         String
  category            String           // "schematic" | "principle" | "culture"
  specifications      String?          // JSON string of specs (e.g. GSM, weave, cut)
  careInstructions    String?
  images              String           // JSON string of image URLs
  basePrice           Float
  currency            String           @default("INR")
  isPublished         Boolean          @default(true)
  isFeatured          Boolean          @default(false)
  printifyProductId   String?
  printifyBlueprintId Int?
  printifyProviderId  Int?
  lastSyncedAt        DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  variants            ProductVariant[]
}

model ProductVariant {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  title             String      // e.g. "M / Pitch Black"
  size              String      // "S", "M", "L", "XL", "2XL"
  color             String      // "Pitch Black", "Steel Grey", "White"
  colorHex          String?
  sku               String?     @unique
  price             Float
  costPrice         Float?      // Printify production cost (never public)
  isAvailable       Boolean     @default(true)
  printifyVariantId Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  orderItems        OrderItem[]
}

model Order {
  id                 String           @id @default(cuid())
  orderNumber        String           @unique // e.g. "AM-2610-8492"
  trackingToken      String           @unique // Unpredictable UUID for tracking
  customerEmail      String
  customerPhone      String?
  customerName       String
  shippingAddress1   String
  shippingAddress2   String?
  city               String
  state              String
  postalCode         String
  country            String
  currency           String           @default("INR")
  subtotal           Float
  shippingFee        Float
  taxAmount          Float
  totalAmount        Float
  paymentStatus      String           @default("PENDING") // PENDING, AUTHORIZED, PAID, FAILED, REFUNDED
  fulfillmentStatus  String           @default("UNFULFILLED") // UNFULFILLED, QUEUED, SUBMITTED_TO_PRINTIFY, IN_PRODUCTION, SHIPPED, DELIVERED, SUBMISSION_FAILED, CANCELLED
  razorpayOrderId    String?          @unique
  razorpayPaymentId  String?          @unique
  razorpaySignature  String?
  printifyOrderId    String?
  printifyStatus     String?
  carrier            String?
  trackingNumber     String?
  trackingUrl        String?
  adminNotes         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  items              OrderItem[]
  fulfillmentJobs    FulfillmentJob[]
  auditLogs          AuditLog[]
}

model OrderItem {
  id                      String          @id @default(cuid())
  orderId                 String
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId               String?
  variant                 ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productTitle            String
  variantTitle            String
  size                    String
  color                   String
  unitPrice               Float
  quantity                Int
  totalPrice              Float
  printifyBlueprintId     Int?
  printifyPrintProviderId Int?
  printifyVariantId       Int?
}

model FulfillmentJob {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  idempotencyKey String    @unique
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, RETRY_SCHEDULED
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastError      String?
  nextRetryAt    DateTime?
  payload        String?
  response       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String   // "RAZORPAY" | "PRINTIFY"
  eventId   String   @unique
  eventType String
  payload   String
  status    String   @default("PROCESSED") // PROCESSED, FAILED, IGNORED
  error     String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action    String
  actor     String   @default("SYSTEM")
  details   String?
  createdAt DateTime @default(now())
}
